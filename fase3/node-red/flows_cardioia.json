  {
    "id": "tratar_telemetria",
    "type": "function",
    "z": "tab_cardioia",
    "name": "Separar sinais e alertas",
    "func": "const leitura = msg.payload;\nif (!leitura || typeof leitura !== 'object') {\n  node.warn('Telemetria descartada: payload não é um objeto JSON.');\n  return null;\n}\nconst bpm = Number(leitura.bpm);\nconst temperatura = Number(leitura.temperatura_c);\nconst umidade = Number(leitura.umidade_pct);\nif (![bpm, temperatura, umidade].every(Number.isFinite)) {\n  node.warn('Telemetria descartada: valor numérico ausente ou inválido.');\n  return null;\n}\nconst sequencia = Number(leitura.sequencia);\nconst chaveSequencia = `ultima_sequencia_${leitura.paciente_id || 'desconhecido'}`;\nconst anterior = flow.get(chaveSequencia);\nconst lacuna = Number.isFinite(sequencia) && Number.isFinite(anterior) && sequencia > anterior + 1\n  ? sequencia - anterior - 1\n  : 0;\nif (Number.isFinite(sequencia)) flow.set(chaveSequencia, sequencia);\nconst alerta = leitura.alerta === true || bpm >= 120 || temperatura >= 38;\nconst horario = new Date().toLocaleTimeString('pt-BR');\nconst aviso = alerta\n  ? `🔴 ALERTA SIMULADO: ${bpm} BPM | ${temperatura.toFixed(1)} °C`\n  : `🟢 Sem alerta pelos limites: ${bpm} BPM | ${temperatura.toFixed(1)} °C`;\nconst integridade = lacuna > 0 ? ` | lacuna detectada: ${lacuna}` : '';\nconst fila = `Fila Edge: ${Number(leitura.fila_offline ?? 0)} pendência(s) | descartadas: ${Number(leitura.amostras_descartadas ?? 0)}${integridade} | ${horario}`;\nreturn [\n  { payload: bpm, topic: 'BPM' },\n  { payload: temperatura },\n  { payload: umidade },\n  { payload: aviso },\n  { payload: fila },\n  { payload: leitura }\n];",
    "outputs": 6,
    "timeout": "",
    "noerr": 0,
    "initialize": "",
    "finalize": "",
    "libs": [],
    "x": 570,
    "y": 160,
    "wires": [["chart_bpm"], ["gauge_temperatura"], ["gauge_umidade"], ["texto_alerta"], ["texto_fila"], ["debug_telemetria"]]
  },
