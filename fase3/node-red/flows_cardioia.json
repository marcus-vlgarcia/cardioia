  {
    "id": "json_telemetria",
    "type": "json",
    "z": "tab_cardioia",
    "name": "Interpretar JSON",
    "property": "payload",
    "action": "obj",
    "pretty": false,
    "x": 350,
    "y": 160,
    "wires": [["tratar_telemetria"]]
  },
  {
    "id": "tratar_telemetria",
    "type": "function",
    "z": "tab_cardioia",
    "name": "Separar sinais e alertas",
    "func": "const leitura = msg.payload;\nif (!leitura || typeof leitura.temperatura_c !== 'number') return null;\nconst bpm = Number(leitura.bpm || 0);\nconst temperatura = Number(leitura.temperatura_c);\nconst alerta = Boolean(leitura.alerta) || bpm >= 120 || temperatura >= 38;\nconst horario = new Date().toLocaleTimeString('pt-BR');\nconst aviso = alerta\n  ? `🔴 ALERTA: ${bpm} BPM | ${temperatura.toFixed(1)} °C`\n  : `🟢 Monitoramento normal: ${bpm} BPM | ${temperatura.toFixed(1)} °C`;\nconst fila = `Fila Edge: ${leitura.fila_offline ?? 0} pendência(s) | ${horario}`;\nreturn [\n  { payload: bpm, topic: 'BPM' },\n  { payload: temperatura },\n  { payload: Number(leitura.umidade_pct) },\n  { payload: aviso },\n  { payload: fila },\n  { payload: leitura }\n];",
    "outputs": 6,
    "timeout": "",
    "noerr": 0,
    "initialize": "",
    "finalize": "",
    "libs": [],
    "x": 570,
    "y": 160,
    "wires": [["chart_bpm"], ["gauge_temperatura"], ["gauge_umidade"], ["texto_alerta"], ["texto_fila"], ["debug_telemetria"]]
  },
